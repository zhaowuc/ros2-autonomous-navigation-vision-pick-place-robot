<?xml version="1.0"?>
<robot name="roscar_dofbot_temp" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- ROS coordinate convention: X forward, Y left, Z up. -->

  <material name="body_gray">
    <color rgba="0.25 0.28 0.32 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="arm_blue">
    <color rgba="0.05 0.28 0.80 1.0"/>
  </material>
  <material name="tool_orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>

  <xacro:macro name="box_link" params="name size material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="base_footprint"/>

  <xacro:box_link name="base_link" size="0.55 0.54 0.04" material="body_gray"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1567" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="imu_link" size="0.045 0.035 0.012" material="sensor_black"/>
  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.070 0 -0.0767" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="n300_imu_link" size="0.045 0.035 0.012" material="sensor_black"/>
  <joint name="base_link_to_n300_imu_link" type="fixed">
    <parent link="base_link"/>
    <child link="n300_imu_link"/>
    <origin xyz="-0.170 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="laser_link" size="0.075 0.075 0.045" material="sensor_black"/>
  <joint name="base_link_to_laser_link" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- 2026-07-24 N10Plus effective LaserScan zero: +5.293145 deg. -->
    <origin xyz="-0.235 0 0.350" rpy="0 0 0.092382808"/>
  </joint>

  <!--
    Astra Pro Plus is mounted directly below the lidar.  Its chassis-facing
    frame stays aligned with base_link; the lidar's +5.293145 deg value above
    is a LaserScan index correction and must not be copied to this camera.
    base_footprint -> astra_link is therefore (-0.235, 0, 0.4767) m.
  -->
  <xacro:box_link name="astra_link" size="0.165 0.030 0.040" material="sensor_black"/>
  <joint name="base_link_to_astra_link" type="fixed">
    <parent link="base_link"/>
    <child link="astra_link"/>
    <origin xyz="-0.235 0 0.320" rpy="0 0 0"/>
  </joint>

  <link name="astra_depth_frame"/>
  <joint name="astra_link_to_depth_frame" type="fixed">
    <parent link="astra_link"/>
    <child link="astra_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="astra_depth_optical_frame"/>
  <joint name="astra_depth_to_optical" type="fixed">
    <parent link="astra_depth_frame"/>
    <child link="astra_depth_optical_frame"/>
    <!-- REP-103 camera optical frame: +X right, +Y down, +Z forward. -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="astra_color_frame"/>
  <joint name="astra_link_to_color_frame" type="fixed">
    <parent link="astra_link"/>
    <child link="astra_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="astra_color_optical_frame"/>
  <joint name="astra_color_to_optical" type="fixed">
    <parent link="astra_color_frame"/>
    <child link="astra_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <xacro:box_link name="arm_base_link" size="0.070 0.070 0.040" material="arm_blue"/>
  <joint name="base_link_to_arm_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.223 0 0.0775" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="link1" size="0.045 0.045 0.060" material="arm_blue"/>
  <joint name="joint1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.5"/>
  </joint>

  <xacro:box_link name="link2" size="0.085 0.035 0.035" material="arm_blue"/>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.0382" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.5"/>
  </joint>

  <xacro:box_link name="link3" size="0.085 0.032 0.032" material="arm_blue"/>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="-0.085 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.5"/>
  </joint>

  <xacro:box_link name="link4" size="0.080 0.030 0.030" material="arm_blue"/>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="-0.085 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.5"/>
  </joint>

  <xacro:box_link name="wrist_camera_link" size="0.030 0.030 0.024" material="sensor_black"/>
  <joint name="link4_to_wrist_camera_link" type="fixed">
    <parent link="link4"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0 0.0585 0" rpy="0 0 0"/>
  </joint>

  <link name="wrist_color_optical_frame"/>
  <joint name="wrist_camera_to_color_optical" type="fixed">
    <parent link="wrist_camera_link"/>
    <child link="wrist_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="wrist_depth_optical_frame"/>
  <joint name="wrist_camera_to_depth_optical" type="fixed">
    <parent link="wrist_camera_link"/>
    <child link="wrist_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <xacro:box_link name="link5" size="0.050 0.028 0.028" material="arm_blue"/>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="-0.080 0 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="3.1416" effort="8.0" velocity="1.5"/>
  </joint>

  <xacro:box_link name="gripper_base_link" size="0.035 0.040 0.025" material="tool_orange"/>
  <joint name="link5_to_gripper_base_link" type="fixed">
    <parent link="link5"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>
  <joint name="gripper_base_to_tool0" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool0"/>
    <origin xyz="0.0986 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool0_open_ref"/>
  <joint name="gripper_base_to_tool0_open_ref" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool0_open_ref"/>
    <origin xyz="0.070 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool0_close_ref"/>
  <joint name="gripper_base_to_tool0_close_ref" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool0_close_ref"/>
    <origin xyz="0.1086 0 0" rpy="0 0 0"/>
  </joint>
</robot>
